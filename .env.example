# 응대 검사기·민원-응대.cmd LLM. 민원 CRUD와 분리됩니다.
# 아래 공급자 중 하나를 고릅니다. 실제 키는 .env에만 넣고 Git에 넣지 않습니다.

# --- EXAONE API (LG AI연구원 K-EXAONE 2.5 무료 API: https://docs.exaone.ai) ---
# 주석은 값 뒤가 아니라 별도 줄에 둡니다. 로더는 값 뒤의 # 를 지우지 않습니다.
# COMPLAINT_LLM_PROVIDER=exaone_api
# COMPLAINT_LLM_MODEL=k-exaone_v2.5
# EXAONE_API_KEY=
# 추론 강도: low(빠른 응답) · high(복잡한 판단) · max(최고 정확도, 공식 기본값)
# EXAONE_REASONING_EFFORT=max
# 최대 생성 토큰. 내부 추론 토큰과 최종 답변 토큰을 합한 한도입니다.
# EXAONE_MAX_TOKENS=16384
# 판정 JSON 형식 안정성을 위해 공식 권장 1.0보다 낮춘 값입니다.
# EXAONE_TEMPERATURE=0.7
# EXAONE_TOP_P=0.95

# --- API (OpenAI Responses) ---
COMPLAINT_LLM_PROVIDER=openai_api
COMPLAINT_LLM_MODEL=gpt-6-luna
COMPLAINT_LLM_REASONING_EFFORT=medium
OPENAI_API_KEY=

# --- CLI (로그인된 Codex) ---
# COMPLAINT_LLM_PROVIDER=codex_cli
# COMPLAINT_CODEX_COMMAND=codex
# COMPLAINT_LLM_MODEL=gpt-6-luna
# COMPLAINT_LLM_REASONING_EFFORT=medium

# --- 기존 호환 토큰 (PROVIDER=legacy 일 때) ---
# COMPLAINT_LLM_PROVIDER=legacy
# COMPLAINT_LLM_URL=
# COMPLAINT_LLM_TOKEN=
# PUBLIC_LLM_TOKEN=
# XAI_API_KEY=

# 검색 임베딩. 기본 e5-small-ko(384차원, CPU). 이전 intfloat 색인은 e5-small, BGE-M3는 bge-m3.
# RAG_EMBEDDING_PROFILE=e5-small-ko
# RAG_EMBEDDING_PROFILE=e5-small
# RAG_EMBEDDING_PROFILE=bge-m3

# 시연 웹 업무 저장. 검색과 같은 PostgreSQL 서버, 스키마는 complaint_app.
# 비우면 PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD 를 씁니다.
# COMPLAINT_DATABASE_URL=postgresql://user@127.0.0.1:5432/complaints_native
# COMPLAINT_APP_SCHEMA=complaint_app
